{
  "name": "recipe-rest-api",
  "version": "1.0.0",
  "description": "Ryan's Recipes API",
  "main": "dist/server.js",
  "engines": {
    "node": "24"
  },
  "type": "module",
  "scripts": {
    "build": "tsc",
    "migrate": "node --import tsx ./node_modules/knex/bin/cli.js --knexfile='./src/knexfile.ts' migrate:latest",
    "migrate:prod": "node ./node_modules/knex/bin/cli.js --knexfile='./dist/knexfile.js' migrate:latest",
    "migrate.fresh": "node --import tsx ./node_modules/knex/bin/cli.js --knexfile='./src/knexfile.ts' migrate:rollback --all && npm run migrate",
    "dev": "npx nodemon --inspect=0.0.0.0:9229 --watch dist dist/server.js",
    "start": "node dist/server.js",
    "test": "npm run migrate.fresh && node --import tsx ./node_modules/mocha/bin/mocha.js 'test/**/*.test.ts'",
    "watch": "tsc -w"
  },
  "author": "Ryan Brown",
  "license": "ISC",
  "dependencies": {
    "ajv": "^8.0.0",
    "ajv-formats": "^3.0.0",
    "bcrypt": "^6.0.0",
    "cheerio": "^1.0.0-rc.3",
    "commander": "^14.0.0",
    "connect-session-knex": "^5.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.0.0",
    "express": "^5.0.0",
    "express-session": "^1.17.0",
    "jsonld": "^9.0.0",
    "knex": "^3.0.0",
    "method-override": "^3.0.0",
    "microdata-node": "^2.0.0",
    "moment": "^2.29.3",
    "node-fetch": "^3.0.0",
    "objection": "^3.0.0",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "pg": "^8.0.0",
    "striptags": "^3.1.1"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.0.0",
    "@flydotio/dockerfile": "^0.7.0",
    "@types/bcrypt": "^6.0.0",
    "@types/connect-pg-simple": "^7.0.0",
    "@types/cors": "^2.8.6",
    "@types/debug": "^4.1.5",
    "@types/express": "^5.0.0",
    "@types/express-session": "^1.17.0",
    "@types/json-schema": "^7.0.11",
    "@types/jsonld": "^1.5.1",
    "@types/method-override": "3.0.0",
    "@types/mocha": "^10.0.0",
    "@types/node-fetch": "^2.6.0",
    "@types/passport": "^1.0.3",
    "@types/passport-local": "^1.0.33",
    "@types/supertest": "^6.0.0",
    "debug": "^4.3.4",
    "fishery": "^2.2.2",
    "mocha": "^10.0.0",
    "nodemon": "^3.0.0",
    "schema-dts": "^1.1.0",
    "supertest": "^7.0.0",
    "ts-node": "^10.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.0.0"
  }
}
